ENVIRONMENT=local
AUTONOMY_MODE=sandbox

# LLM gateway. LiteLLM lets one code path call multiple providers.
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-2.0-flash
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# Local infrastructure.
DATABASE_URL=postgresql+psycopg://revenueops:revenueops@localhost:5432/revenueops
REDIS_URL=redis://localhost:6379/0

# Sandbox-first live integrations. Use demo accounts first.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Real-account mode must be explicitly allowlisted.
ALLOWED_EMAIL_DOMAINS=sandbox.example.com
ALLOWED_SLACK_CHANNELS=demo-alerts
ALLOWED_GITHUB_REPOS=demo/revenueops-agent-control-tower

# Observability.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

